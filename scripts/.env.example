# 抖音知识蒸馏引擎配置

# 阿里云百炼 API Key（必需）
DASHSCOPE_API_KEY=

# 输出目录（Markdown 笔记存放位置）
OUTPUT_DIR=~/Documents/ZhiweiVault/Inbox

# 通义千问模型
QWEN_MODEL=qwen-plus

# ASR 模型选择：sensevoice-v1（短视频推荐）| paraformer-v2（长内容）
ASR_MODEL=sensevoice-v1

# ASR 策略：auto（优先字幕，无字幕则 ASR）| force_asr（强制 ASR）
ASR_POLICY=auto

# 本地 ASR 模型（mlx-whisper）：tiny | small | medium | large
LOCAL_ASR_MODEL=small

# 日志级别：DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO